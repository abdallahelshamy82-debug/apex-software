# Optional: Set this to your local network IP (e.g. http://192.168.1.5:3000) for testing on physical devices,
# or to your deployed backend production URL (e.g. https://api.apexsoftware.agency) for Google Play Store release.
# By default:
# - Web automatically connects to current hostname:3000
# - Android Emulator automatically connects to http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
