# ==============================================================================
# ⚙️ APEX BACKEND CONFIGURATION (.env)
# ==============================================================================

# 1. منفذ السيرفر (اختياري - الافتراضي 3000)
PORT=3000

# 2. إيميلات المديرين (Admin Emails)
# يمكنك كتابة أي إيميل هنا مفصولاً بفاصلة (,) وسيصبح مديراً بصلاحيات كاملة فور تسجيل دخوله:
ADMIN_EMAILS=dev@gmail.com,admin@apex.com

# 3. إعدادات بريد Gmail لإرسال الإشعارات وتحديثات المشاريع للعملاء (اختياري):
# للحصول على كلمة مرور التطبيقات (App Password): myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=xxxx xxxx xxxx xxxx
